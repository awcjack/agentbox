@@ -0,0 +1,17 @@
+import { lstatSync } from "node:fs";
+import { dirname, isAbsolute, join } from "node:path";
+
+// Agentbox's native Pi history UI writes this sidecar beside the JSONL file.
+// Keep the check shared by the extension and standalone CLI. A legacy record
+// without sessionFile must re-register before it is safe to address again.
+export function isArchived(record) {
+  if (record.sessionFile === null) return false; // Explicitly ephemeral.
+  if (typeof record.sessionFile !== "string" || !isAbsolute(record.sessionFile)
+      || typeof record.sessionId !== "string" || !/^[a-zA-Z0-9_-]{1,512}$/.test(record.sessionId)) return true;
+  try {
+    lstatSync(join(dirname(record.sessionFile), `.archived-${record.sessionId.toLowerCase()}`));
+    return true;
+  } catch (error) {
+    return error.code !== "ENOENT"; // Unreadable archive state is unavailable.
+  }
+}
