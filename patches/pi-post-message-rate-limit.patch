+
+export const OUTBOUND_WINDOW_MS = 60_000;
+export const OUTBOUND_CAP = 8;
+export const OUTBOUND_PER_TARGET_CAP = 4;
+
+/**
+ * Outbound send caps teach the model to stop: unlike LoopGuard (silent drop
+ * on receive), exceeding these fails send_message before deposit.
+ */
+export class OutboundGuard {
+  private recent: number[] = [];
+  private perTarget = new Map<string, number[]>();
+
+  assertAllowed(addresses: string[], now = Date.now()): void {
+    if (addresses.length === 0) return;
+    this.recent = this.recent.filter((t) => now - t < OUTBOUND_WINDOW_MS);
+    if (this.recent.length + addresses.length > OUTBOUND_CAP) {
+      throw new Error(
+        `send_message rate limit: at most ${OUTBOUND_CAP} messages per ${OUTBOUND_WINDOW_MS / 1000}s ` +
+          `(this send would be ${this.recent.length + addresses.length}). ` +
+          "Batch updates into one message; do not send acknowledgment-only replies.",
+      );
+    }
+    for (const address of addresses) {
+      const times = (this.perTarget.get(address) ?? []).filter((t) => now - t < OUTBOUND_WINDOW_MS);
+      if (times.length + 1 > OUTBOUND_PER_TARGET_CAP) {
+        throw new Error(
+          `send_message rate limit: at most ${OUTBOUND_PER_TARGET_CAP} messages to the same target ` +
+            `per ${OUTBOUND_WINDOW_MS / 1000}s (${address}). ` +
+            "Batch updates into one message; do not send acknowledgment-only replies.",
+        );
+      }
+    }
+  }
+
+  record(addresses: string[], now = Date.now()): void {
+    for (const address of addresses) {
+      const times = (this.perTarget.get(address) ?? []).filter((t) => now - t < OUTBOUND_WINDOW_MS);
+      times.push(now);
+      this.perTarget.set(address, times);
+      this.recent.push(now);
+    }
+    this.recent = this.recent.filter((t) => now - t < OUTBOUND_WINDOW_MS);
+  }
+}
